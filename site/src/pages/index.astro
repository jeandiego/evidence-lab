---
import { url } from '../lib/url'
// A raiz não tem conteúdo próprio: pt-br é o padrão; inglês só pelo seletor de idioma.
const target = url('pt-br')
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <title>Synko Lab</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>
      location.replace(target)
    </script>
  </head>
  <body>
    <a href={target}>Synko Lab</a>
  </body>
</html>
