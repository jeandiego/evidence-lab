---
import { url } from '../../lib/url'
import Base from '../../layouts/Base.astro'
import IssueTitle from '../../components/IssueTitle.astro'
import { LANGS, formatDate, t, type Lang } from '../../lib/i18n'
import { assetUrl, postPath, postsFor } from '../../lib/posts'

export function getStaticPaths() {
  return LANGS.map(lang => ({ params: { lang } }))
}

const lang = Astro.params.lang as Lang
const strings = t(lang)
const posts = await postsFor(lang)
const [latest, ...older] = posts
const alternates = Object.fromEntries(LANGS.map(code => [code, url(code)]))
const poster = latest ? assetUrl(latest, latest.data.poster) : undefined
const foreign = (lang: Lang, postLang: string) => postLang !== lang
---

<Base lang={lang} title="Evidence Lab · Synko" description={strings.siteDescription} alternates={alternates}>
  <section class="lab-intro container">
    <h1 class="lab-intro__title">Evidence Lab</h1>
    <p class="lab-intro__text">{strings.intro}</p>
  </section>

  {
    latest ? (
      <section class="cover container" aria-label={strings.latest}>
        <a class="cover__link" href={postPath(latest.data.lang as Lang, latest.data.slug)}>
          <div class="cover__text">
            <p class="cover__number" aria-hidden="true">
              <span class="cover__no">Nº</span>
              {latest.data.number}
            </p>
            <IssueTitle as="h2" class="cover__title" title={latest.data.title} emphasis={latest.data.emphasis} />
            <p class="cover__thesis">{latest.data.thesis}</p>
            <p class="cover__meta">
              <time datetime={latest.data.date.toISOString().slice(0, 10)}>{formatDate(latest.data.date, lang)}</time>
              {foreign(lang, latest.data.lang) && <span>{strings.onlyIn}</span>}
              <span class="cover__cta">
                {strings.read}
                <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.4" />
                </svg>
              </span>
            </p>
          </div>
          {poster && (
            <div class="cover__media">
              <img src={poster} alt="" width="1080" height="1350" loading="eager" decoding="async" />
            </div>
          )}
        </a>
      </section>
    ) : (
      <p class="empty container">{strings.empty}</p>
    )
  }

  {
    older.length > 0 && (
      <section class="archive container" aria-labelledby="archive-title">
        <h2 id="archive-title" class="label">
          {strings.editions}
        </h2>
        <ol class="archive__list">
          {older.map(post => (
            <li>
              <a class="archive__row" href={postPath(post.data.lang as Lang, post.data.slug)}>
                <span class="archive__number">Nº {post.data.number}</span>
                <span class="archive__title">{post.data.title}</span>
                <span class="archive__thesis">{post.data.thesis}</span>
                <time class="archive__date" datetime={post.data.date.toISOString().slice(0, 10)}>
                  {formatDate(post.data.date, lang)}
                </time>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }
</Base>

<style>
  .lab-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
    align-items: end;
    gap: 24px clamp(32px, 6vw, 96px);
    padding-block: clamp(40px, 6vw, 72px) clamp(28px, 4vw, 44px);
    border-bottom: 1px solid var(--rule-strong);
  }

  .lab-intro__title {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.2rem, 1.5rem + 3vw, 3.65rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .lab-intro__text {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .cover__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 360px);
    gap: clamp(32px, 6vw, 96px);
    padding-block: clamp(36px, 5vw, 64px);
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }

  .cover__text {
    display: flex;
    flex-direction: column;
  }

  .cover__number {
    display: flex;
    align-items: flex-start;
    gap: 0.08em;
    margin: 0 0 clamp(16px, 2.4vw, 28px) -0.05em;
    color: var(--ink);
    font-size: clamp(6rem, 18vw, 12rem);
    font-weight: 200;
    line-height: 0.8;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }

  .cover__no {
    margin-top: 0.14em;
    color: var(--wine-text);
    font-family: var(--font-mono);
    font-size: 0.1em;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .cover :global(.cover__title) {
    max-width: 18ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.3rem);
    font-weight: 330;
    line-height: 1.04;
    letter-spacing: -0.03em;
    transition: color 200ms var(--ease-out);
  }

  .cover :global(.cover__title em) {
    color: var(--wine-text);
    font-style: normal;
  }

  .cover__thesis {
    max-width: 48ch;
    margin: 22px 0 0;
    color: var(--ink-soft);
    font-size: 1.12rem;
    line-height: 1.5;
  }

  .cover__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 28px;
    margin: auto 0 0;
    padding-top: 32px;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
  }

  .cover__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--wine-text);
    font-weight: 600;
  }

  .cover__cta .icon {
    transition: transform 280ms var(--ease-out);
  }

  .cover__link:hover .cover__cta .icon {
    transform: translateX(4px);
  }

  .cover__media img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--media-bg);
    border: 1px solid var(--rule);
    border-radius: 12px;
    filter: var(--media-filter);
    transition: transform 420ms var(--ease-out), border-color 200ms var(--ease-out);
  }

  .cover__link:hover .cover__media img {
    transform: translateY(-4px);
    border-color: var(--rule-strong);
  }

  .archive {
    margin-top: 48px;
  }

  .archive__list {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule-strong);
  }

  .archive__row {
    display: grid;
    grid-template-columns: 90px minmax(0, 1.1fr) minmax(0, 1fr) auto;
    gap: 24px;
    align-items: baseline;
    padding-block: 20px;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }

  .archive__number,
  .archive__date {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .archive__title {
    color: var(--ink);
    font-size: 1.15rem;
  }

  .archive__thesis {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .archive__row:hover .archive__title {
    color: var(--wine-text);
  }

  .empty {
    padding-block: 64px;
    color: var(--ink-muted);
  }

  @media (max-width: 860px) {
    .lab-intro,
    .cover__link {
      grid-template-columns: minmax(0, 1fr);
    }

    .cover__media {
      max-width: 340px;
    }

    .archive__row {
      grid-template-columns: 70px minmax(0, 1fr);
    }

    .archive__thesis,
    .archive__date {
      grid-column: 2;
    }
  }
</style>
