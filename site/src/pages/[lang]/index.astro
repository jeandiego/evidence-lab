---
import { url } from '../../lib/url'
import Base from '../../layouts/Base.astro'
import IssueTitle from '../../components/IssueTitle.astro'
import { LANGS, formatDate, t, type Lang } from '../../lib/i18n'
import { assetUrl, postPath, postsFor } from '../../lib/posts'

export function getStaticPaths() {
  return LANGS.map(lang => ({ params: { lang } }))
}

const lang = Astro.params.lang as Lang
const strings = t(lang)
const posts = await postsFor(lang)
const [latest, ...older] = posts
const alternates = Object.fromEntries(LANGS.map(code => [code, url(code)]))
const poster = latest ? assetUrl(latest, latest.data.poster) : undefined
const foreign = (lang: Lang, postLang: string) => postLang !== lang
---

<Base lang={lang} title="Synko Lab" description={strings.siteDescription} alternates={alternates}>
  <section class="lab-intro container">
    <h1 class="visually-hidden">Synko Lab</h1>
    <p class="lab-intro__text">{strings.intro}</p>
  </section>

  {
    latest ? (
      <section class="cover container" aria-label={strings.latest}>
        <a class="cover__link" href={postPath(latest.data.lang as Lang, latest.data.slug)}>
          <div class="cover__text">
            <p class="cover__number">{strings.latest} · Nº {latest.data.number}</p>
            <IssueTitle as="h2" class="cover__title" title={latest.data.title} emphasis={latest.data.emphasis} />
            <p class="cover__thesis">{latest.data.thesis}</p>
            <p class="cover__meta">
              <time datetime={latest.data.date.toISOString().slice(0, 10)}>{formatDate(latest.data.date, lang)}</time>
              {foreign(lang, latest.data.lang) && <span>{strings.onlyIn}</span>}
              <span class="cover__cta">
                {strings.read}
                <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.4" />
                </svg>
              </span>
            </p>
          </div>
          {poster && (
            <div class="cover__media">
              <img src={poster} alt="" width="1080" height="1350" loading="eager" decoding="async" />
            </div>
          )}
        </a>
      </section>
    ) : (
      <p class="empty container">{strings.empty}</p>
    )
  }

  {
    older.length > 0 && (
      <section class="archive container" aria-labelledby="archive-title">
        <h2 id="archive-title" class="label">
          {strings.editions}
        </h2>
        <ol class="archive__list">
          {older.map(post => (
            <li>
              <a class="archive__row" href={postPath(post.data.lang as Lang, post.data.slug)}>
                <span class="archive__number">Nº {post.data.number}</span>
                <span class="archive__title">{post.data.title}</span>
                <span class="archive__thesis">{post.data.thesis}</span>
                <time class="archive__date" datetime={post.data.date.toISOString().slice(0, 10)}>
                  {formatDate(post.data.date, lang)}
                </time>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }
</Base>

<style>
  /* O nome já está no header: a home abre só com a frase do lab, discreta, acima da capa. */
  .lab-intro {
    padding-block: clamp(20px, 3vw, 28px);
    border-bottom: 1px solid var(--rule);
  }

  .lab-intro__text {
    max-width: 62ch;
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .cover__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 360px);
    gap: clamp(32px, 6vw, 96px);
    padding-block: clamp(36px, 5vw, 64px);
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }

  .cover__text {
    display: flex;
    flex-direction: column;
  }

  .cover__number {
    margin: 0 0 clamp(16px, 2vw, 24px);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .cover :global(.cover__title) {
    max-width: 24ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.3rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  .cover :global(.cover__title em) {
    color: var(--accent);
    font-style: normal;
  }

  .cover__thesis {
    max-width: 56ch;
    margin: 22px 0 0;
    color: var(--ink-soft);
    font-size: 1.12rem;
    line-height: 1.5;
  }

  .cover__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 28px;
    margin: auto 0 0;
    padding-top: 32px;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
  }

  .cover__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: text-decoration-color var(--fast) var(--ease);
  }

  .cover__link:hover .cover__cta {
    text-decoration-color: currentColor;
  }

  .cover__media img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--media-bg);
    filter: var(--media-filter);
  }

  .archive {
    margin-top: 48px;
  }

  .archive__list {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule-strong);
  }

  .archive__row {
    display: grid;
    grid-template-columns: 90px minmax(0, 1.1fr) minmax(0, 1fr) auto;
    gap: 24px;
    align-items: baseline;
    padding-block: 20px;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }

  .archive__number,
  .archive__date {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .archive__title {
    color: var(--ink);
    font-size: 1.15rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: text-decoration-color var(--fast) var(--ease);
  }

  .archive__thesis {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .archive__row:hover .archive__title {
    text-decoration-color: currentColor;
  }

  .empty {
    padding-block: 64px;
    color: var(--ink-muted);
  }

  @media (max-width: 860px) {
    .cover__link {
      grid-template-columns: minmax(0, 1fr);
    }

    .cover__media {
      max-width: 340px;
    }

    .archive__row {
      grid-template-columns: 70px minmax(0, 1fr);
    }

    .archive__thesis,
    .archive__date {
      grid-column: 2;
    }
  }
</style>
