<style>
  /*
    Movimento de contato do brand (§12): os quadrados se afastam pela diagonal e voltam a se
    tocar, parando exatamente no contato. Loop longo e de propósito: 12s, quase todo em contato.
    O brand prevê o logo sem loop; o loop foi pedido para o header do lab.
  */
  .is-animated {
    overflow: visible;
  }

  .is-animated .square {
    animation: 12s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .is-animated .square--a {
    animation-name: contact-a;
  }

  .is-animated .square--b {
    animation-name: contact-b;
  }

  /* 4% de 12s = 480ms, a duração de contato do brand. Distância: 0,35 do quadrado. */
  @keyframes contact-a {
    0%,
    96%,
    100% {
      transform: translate(-176px, 176px);
    }
    4%,
    90% {
      transform: none;
    }
  }

  @keyframes contact-b {
    0%,
    96%,
    100% {
      transform: translate(176px, -176px);
    }
    4%,
    90% {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .is-animated .square {
      animation: none;
    }
  }
</style>
