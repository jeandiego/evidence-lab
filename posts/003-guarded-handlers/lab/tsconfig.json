{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": [
      "vitest/globals"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
