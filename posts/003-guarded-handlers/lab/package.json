  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^26.1.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
