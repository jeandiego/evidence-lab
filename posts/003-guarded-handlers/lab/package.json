    "evidence": "npm run evidence:behavior && npm run evidence:structure && npm run evidence:change && npm run benchmark:runtime",
    "reel:check": "node scripts/reel.mjs check",
    "reel:sheet": "node scripts/reel.mjs sheet",
    "reel:render": "node scripts/reel.mjs render --out ../post/assets/reel-003.mp4"
  },
  "dependencies": {
